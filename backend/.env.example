# Temple & Heritage Information Assistant — backend configuration
# Copy this file to .env and adjust the values. Never commit .env.

# --- LLM provider (OpenAI-compatible chat completions) ---
# OpenRouter (OpenAI-compatible API):
LLM_BASE_URL=https://openrouter.ai/api/v1

LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Leave LLM_API_KEY/LLM_MODEL unset for retrieval-only operation
# (no generated answers; relevant evidence is still returned).

# --- Embedding model ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Persistent local vector store (ChromaDB) ---
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=temple_heritage

# --- Document chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Public-source collection (conservative defaults) ---
COLLECTOR_TIMEOUT_SECONDS=12
COLLECTOR_RETRIES=2
COLLECTOR_BACKOFF_SECONDS=0.5
COLLECTOR_MIN_DOMAIN_INTERVAL=1.0

# --- Retrieval ---
# Distances are cosine distances (0 = identical, lower is more relevant).
TOP_K=5
RELEVANCE_THRESHOLD=0.7

# --- CORS ---
# Comma-separated list of allowed origins. Do not use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- App ---
APP_NAME=Temple & Heritage Information Assistant
DEBUG=false
